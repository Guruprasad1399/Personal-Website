# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specify which OpenAI model to use (default: gpt-3.5-turbo)
# Available options: gpt-3.5-turbo, gpt-4, gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo

# Note: This project uses OpenAI models (GPT), not Claude/Anthropic
# To switch to Claude, you would need to modify the API integration
